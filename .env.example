# Supabase email/password authentication. Use the project's URL and anon/publishable key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
# Enable email confirmations and allowlist http://localhost:3000/api/auth/callback
# (plus the matching callback URL on your deployed site) in Supabase Auth URL settings.
# Set the confirmation email link to:
# {{ .RedirectTo }}?token_hash={{ .TokenHash }}&type=signup

# Store data is still kept in SQLite.
DATABASE_PATH=./data/shopease.db
